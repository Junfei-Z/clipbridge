{
  "name": "clipbridge",
  "version": "0.7.5",
  "private": true,
  "description": "A local-first device relay with portable Git-based Agent Handoff packages.",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "pretest": "npm run build:web",
    "test": "node --test",
    "build:mac": "bash macos/build-app.sh",
    "build:web": "node scripts/build-web.mjs",
    "handoff": "node scripts/clipbridge-handoff.mjs",
    "signal:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "signal:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run",
    "signal:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
